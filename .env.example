# --- required ---
TPDB_API_KEY=your-theporndb-token

# --- provider identity (must start with tv.plex.agents.custom.) ---
TPDB_IDENTIFIER=tv.plex.agents.custom.theporndb.scenes
TPDB_TITLE=ThePornDB Scenes

# --- movies provider (full releases, TPDB /movies endpoint) ---
TPDB_MOVIES_ENABLE=true
# TPDB_MOVIES_IDENTIFIER=tv.plex.agents.custom.theporndb.movies
# TPDB_MOVIES_TITLE=ThePornDB Movies

# --- jav provider (TPDB /jav endpoint) ---
TPDB_JAV_ENABLE=false
# TPDB_JAV_IDENTIFIER=tv.plex.agents.custom.theporndb.jav
# TPDB_JAV_TITLE=ThePornDB JAV

# --- matching ---
TPDB_MATCH_BY_FILENAME=true
TPDB_STRIP_PATH=true
TPDB_SCORE_METHOD=default
# TPDB_SCORE_METHOD=custom
# TPDB_CUSTOM_SCORE={site} {date} {title}
TPDB_CLEANUP_ENABLE=false
# Comma-separated regexes stripped from the filename before searching
# TPDB_CLEANUP_REGEX=\[.*?\],\(.*?\)
# TPDB_CLEANUP_REPLACE=

# --- metadata shaping ---
TPDB_CONTENT_RATING=XXX
TPDB_COLLECTIONS_FROM_SITE=true
TPDB_COLLECTIONS_FROM_PARENTS=true
TPDB_COLLECTIONS_FROM_NETWORKS=true
TPDB_COLLECTIONS_FROM_TAGS=false
# TPDB_COLLECTION_SITE_PREFIX=
# TPDB_COLLECTION_PARENT_PREFIX=
# TPDB_COLLECTION_NETWORK_PREFIX=
TPDB_CUSTOM_TITLE_ENABLE=false
# TPDB_CUSTOM_TITLE={actors} - {title} [{studio}/{series}]
TPDB_SAVE_TO_COLLECTION=false

# --- service ---
TPDB_LOG_LEVEL=INFO
TPDB_CACHE_TTL=3600
